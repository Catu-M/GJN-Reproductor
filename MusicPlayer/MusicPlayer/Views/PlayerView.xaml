<UserControl x:Class="MusicPlayer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MusicPlayer.Views"
             xmlns:models="clr-namespace:MusicPlayer.Models"
             xmlns:converters="clr-namespace:MusicPlayer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:LyricStateColorConverter x:Key="LyricColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <local:AnimatedBackground Palette="{Binding Palette}"/>

        <Grid Margin="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Border Width="260" Height="260" CornerRadius="8"
                        Background="#2A2A2A" ClipToBounds="True">
                    <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" Margin="0,0,-1,2"/>
                </Border>
                <TextBlock Text="{Binding CurrentSong.Title}" 
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" Width="244" HorizontalAlignment="Center" TextAlignment="Center"/>

                <TextBlock Text="{Binding CurrentSong.Artist}"
                           Foreground="#D0D0D0"
                           FontSize="14" Width="218" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <Grid x:Name="LyricsHost" Grid.Column="1" Margin="48,0,0,0" ClipToBounds="True">
                
                <!--                 <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="Black" Offset="0.18"/>
                        <GradientStop Color="Black" Offset="0.82"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.OpacityMask> -->


                <Canvas>
                    <ItemsControl x:Name="LyricsList"
                                  ItemsSource="{Binding Lyrics}"
                                  Width="{Binding ActualWidth, ElementName=LyricsHost}">
                        <ItemsControl.RenderTransform>
                            <TranslateTransform x:Name="ScrollTransform"/>
                        </ItemsControl.RenderTransform>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LyricLine}">
                                <TextBlock Text="{Binding Text}"
                                          Foreground="White"
                                          FontSize="130"
                                          FontWeight="Bold"
                                          TextAlignment="Center"
                                          TextWrapping="Wrap"
                                          Margin="0,12"
                                          Opacity="0"
                                          RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="White" BlurRadius="20" ShadowDepth="0" Opacity="0.45"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </Grid>
    </Grid>
</UserControl>