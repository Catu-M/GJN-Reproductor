<UserControl x:Class="MusicPlayer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MusicPlayer.Views"
             xmlns:models="clr-namespace:MusicPlayer.Models"
             xmlns:converters="clr-namespace:MusicPlayer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:LyricStateColorConverter x:Key="LyricColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <local:AnimatedBackground Palette="{Binding Palette}"/>

        <Grid Margin="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Border x:Name="CoverBorder" Width="380" Height="380" CornerRadius="8"
                        Background="#2A2A2A" ClipToBounds="True">
                    <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" Margin="0,0,-1,2"/>
                </Border>

                <local:MarqueeText Text="{Binding CurrentSong.Title}"
                                   Width="{Binding ActualWidth, ElementName=CoverBorder}"
                                   Margin="0,20,0,0"
                                   TextElement.Foreground="White"
                                   TextElement.FontSize="26"
                                   TextElement.FontWeight="SemiBold"/>

                <TextBlock Text="{Binding CurrentSong.Artist}"
                           Width="{Binding ActualWidth, ElementName=CoverBorder}"
                           Margin="0,6,0,0"
                           Foreground="#D0D0D0"
                           FontSize="16"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>


            <Grid x:Name="LyricsHost" Grid.Column="1" Margin="48,0,0,0" ClipToBounds="True">
                
                <Canvas>
                    <ItemsControl x:Name="LyricsList"
                                  ItemsSource="{Binding Lyrics}"
                                  Width="{Binding ActualWidth, ElementName=LyricsHost}">
                        <ItemsControl.RenderTransform>
                            <TranslateTransform x:Name="ScrollTransform"/>
                        </ItemsControl.RenderTransform>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LyricLine}">
                                <TextBlock Text="{Binding Text}"
                                          Foreground="White"
                                          FontSize="80"
                                          FontWeight="Bold"
                                          TextAlignment="Center"
                                          TextWrapping="Wrap"
                                          Margin="0,12"
                                          Opacity="0"
                                          RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="White" BlurRadius="20" ShadowDepth="0" Opacity="0.45"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </Grid>
    </Grid>
</UserControl>