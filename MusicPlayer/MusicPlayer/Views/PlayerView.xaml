<UserControl x:Class="MusicPlayer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MusicPlayer.Views"
             xmlns:models="clr-namespace:MusicPlayer.Models"
             xmlns:converters="clr-namespace:MusicPlayer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:LyricStateColorConverter x:Key="LyricColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <local:AnimatedBackground Palette="{Binding Palette}"/>

        <Grid Margin="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Border Width="260" Height="260" CornerRadius="8"
                        Background="#2A2A2A" ClipToBounds="True">
                    <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" Margin="0,0,-1,2"/>
                </Border>
                <TextBlock Text="{Binding CurrentSong.Title}"
                           FontFamily="Montserrat, Segoe UI"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" Width="244" HorizontalAlignment="Center" TextAlignment="Center"/>

                <TextBlock Text="{Binding CurrentSong.Artist}"
                           FontFamily="Montserrat, Segoe UI"
                           Foreground="#D0D0D0"
                           FontSize="14" Width="218" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="1" Margin="48,0,0,0">
                <ItemsControl ItemsSource="{Binding Lyrics}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LyricLine}">
                            <TextBlock Text="{Binding Text}"
                                       Foreground="{Binding State, Converter={StaticResource LyricColorConverter}}"
                                       FontSize="{Binding FontSize}"
                                       Opacity="{Binding Opacity}"
                                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>