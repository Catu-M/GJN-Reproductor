<UserControl x:Class="MusicPlayer.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MusicPlayer.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#0D0D0D" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Elegir carpeta"
                    Command="{Binding ChooseFolderCommand}"
                    Padding="14,8"
                    Background="Black"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"/>
            <Button Content="Abrir pantalla"
                    Click="OpenPlayer_Click"
                    Padding="14,8"
                    Margin="8,0,0,0"
                    Background="Black"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"/>
            <Button Content="Pantalla completa"
                    Click="Fullscreen_Click"
                    Padding="14,8"
                    Margin="8,0,0,0"
                    Background="Black"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"/>
            <TextBlock Text="{Binding LibraryFolder}"
                       Foreground="#8A8A8A"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontSize="12"/>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontSize="12"/>

            <Border Background="#161616"
                    CornerRadius="6"
                    Margin="16,0,0,0"
                    Padding="10,6"
                    Width="220">
                <Grid>
                    <TextBlock Text="Buscar cancion o artista..."
                               Foreground="#6A6A6A"
                               FontSize="13"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             Foreground="White"
                             CaretBrush="White"
                             BorderThickness="0"
                             FontSize="13"/>
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SongsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Song}">
                        <Border Background="#161616"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="44" Height="44"
                                        CornerRadius="4"
                                        Background="#2A2A2A"
                                        Grid.Column="0"/>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding Artist}"
                                               Foreground="#8A8A8A"
                                               FontSize="12"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="▶"
                                        Width="36" Height="36"
                                        Background="Black"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="14"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.PlaySongCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="16,12"
                CornerRadius="8"
                Background="#161616"
                Visibility="{Binding Player.HasSong, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Foreground="White"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Player.CurrentSong.Title, Mode=OneWay}"/>
                        <Run Text=" - " Foreground="#8A8A8A"/>
                        <Run Text="{Binding Player.CurrentSong.Artist, Mode=OneWay}" Foreground="#8A8A8A"/>
                    </TextBlock>

                    <Button Grid.Column="1"
                            Content="X"
                            Command="{Binding StopPlaybackCommand}"
                            ToolTip="Detener"
                            Width="24" Height="24"
                            Background="Transparent"
                            Foreground="#8A8A8A"
                            BorderThickness="0"
                            FontSize="12"
                            Cursor="Hand"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Player.PositionText}"
                               Foreground="#8A8A8A"
                               FontSize="11"
                               FontFamily="Consolas"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <Slider x:Name="ProgressSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding Player.DurationSeconds}"
                            Value="{Binding Player.PositionSeconds, Mode=OneWay}"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"
                            ValueChanged="ProgressSlider_ValueChanged"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Player.DurationText}"
                               Foreground="#8A8A8A"
                               FontSize="11"
                               FontFamily="Consolas"
                               TextAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="&lt;&lt;"
                            Command="{Binding PreviousSongCommand}"
                            Width="36" Height="36"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            Cursor="Hand"/>

                    <Button Content="{Binding Player.PlayPauseLabel}"
                            Command="{Binding Player.TogglePauseCommand}"
                            Width="40" Height="40"
                            Margin="10,0"
                            Background="Black"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="16"
                            Cursor="Hand"/>

                    <Button Content="&gt;&gt;"
                            Command="{Binding NextSongCommand}"
                            Width="36" Height="36"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="15"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>