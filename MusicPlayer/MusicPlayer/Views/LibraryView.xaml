<UserControl x:Class="MusicPlayer.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MusicPlayer.Models">

    <Grid Background="#0D0D0D" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Elegir carpeta"
                    Command="{Binding ChooseFolderCommand}"
                    Padding="14,8"
                    Background="#1DB954"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"/>
            <TextBlock Text="{Binding LibraryFolder}"
                       Foreground="#8A8A8A"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontSize="12"/>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#1DB954"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontSize="12"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Songs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Song}">
                        <Border Background="#161616"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="44" Height="44"
                                        CornerRadius="4"
                                        Background="#2A2A2A"
                                        Grid.Column="0"/>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding Artist}"
                                               Foreground="#8A8A8A"
                                               FontSize="12"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="▶"
                                        Width="36" Height="36"
                                        Background="#1DB954"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="14"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.PlaySongCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
