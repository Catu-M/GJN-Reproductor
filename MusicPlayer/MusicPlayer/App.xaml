<Application x:Class="MusicPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MusicPlayer.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:LyricStateColorConverter x:Key="LyricStateColorConverter"/>

        <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#Montserrat Alternates</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
    </Application.Resources>
</Application>