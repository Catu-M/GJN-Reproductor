<Application x:Class="MusicPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MusicPlayer.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:LyricStateColorConverter x:Key="LyricStateColorConverter"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        </Style>
    </Application.Resources>
</Application>